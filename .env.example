# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────

# ── Google Gemini AI (Primary AI Engine) ──────────────
# Get your FREE API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── IBM Watson Assistant (Optional / Legacy) ──────────
WATSON_ASSISTANT_API_KEY=your_watson_assistant_api_key_here
WATSON_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com
WATSON_ASSISTANT_ID=your_watson_assistant_id_here

# ── IBM watsonx.ai (Optional / Legacy) ────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── HuggingFace (fallback LLM) ────────────────────────
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ── Backend (FastAPI) ─────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── Blender ───────────────────────────────────────────
# Full path to your Blender executable
BLENDER_PATH=/path/to/blender

# ── Frontend (Next.js) ────────────────────────────────
# These are exposed to the browser, prefix with NEXT_PUBLIC_
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WATSON_INTEGRATION_ID=your_watson_web_chat_integration_id
